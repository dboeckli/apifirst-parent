# Flow: createProduct -> getProductById -> patchProductById -> deleteProductById — see restRequest/product-flow-create-patch-delete/product-flow-create-patch-delete.md
# Requires the JPA profile (local-with-jpa / k8s-with-jpa): PATCH and DELETE are not implemented in apifirst-server.
# Bruno skips these requests automatically when the selected environment is not a JPA profile (scripts/jpa-only.js).

### 1) create a product (sets {{productId}} from the Location header)
< ../scripts/traceparent.js
POST http://localhost:{{application-port}}/v1/products
Accept: application/json
Content-Type: application/json
traceparent: 00-{{traceId}}-{{spanId}}-03

{
  "description": "flow product",
  "cost": "5.00",
  "price": "8.95",
  "categories": ["{{product-category-code}}"],
  "dimensions": {
    "length": 10,
    "width": 10,
    "height": 10
  }
}

> {%
    const location = response.headers.valueOf("Location");
    client.global.set("productId", location ? location.split("/").pop() : null);
    client.log("Created product id: " + client.global.get("productId"));

    client.test("createProduct returns 201", function () {
        client.assert(response.status === 201, "expected 201 but got " + response.status);
    });
    client.test("createProduct returns a Location header", function () {
        client.assert(!!location, "Location header missing");
        client.assert(!!client.global.get("productId"), "productId missing in Location header");
    });
%}

### 2) get product by id
< ../scripts/traceparent.js
GET http://localhost:{{application-port}}/v1/products/{{productId}}
Accept: application/json
Content-Type: application/json
traceparent: 00-{{traceId}}-{{spanId}}-03

> {%
    client.test("getProductById returns 200", function () {
        client.assert(response.status === 200, "expected 200 but got " + response.status);
    });
    client.test("returned product id matches", function () {
        client.assert(response.body.id === client.global.get("productId"), "productId mismatch");
    });
%}

### 3) patch only the description (other fields stay untouched)
< ../scripts/traceparent.js
< ../scripts/jpa-only.js
PATCH http://localhost:{{application-port}}/v1/products/{{productId}}
Accept: application/json
Content-Type: application/json
traceparent: 00-{{traceId}}-{{spanId}}-03

{
  "description": "flow product (patched)",
  "price": "9.95"
}

> {%
    client.test("patchProductById returns 200", function () {
        client.assert(response.status === 200, "expected 200 but got " + response.status);
    });
    client.test("description was patched", function () {
        client.assert(response.body.description === "flow product (patched)", "description not patched");
        client.assert(response.body.price === "9.95", "price not patched");
        client.assert(!!response.body.cost, "cost was removed by the patch");
    });
%}

### 4) delete the product by id (fresh product is not used in any order)
< ../scripts/traceparent.js
< ../scripts/jpa-only.js
DELETE http://localhost:{{application-port}}/v1/products/{{productId}}
Accept: application/json
Content-Type: application/json
traceparent: 00-{{traceId}}-{{spanId}}-03

> {%
    client.test("deleteProductById returns 204", function () {
        client.assert(response.status === 204, "expected 204 but got " + response.status);
    });
%}

### 5) verify the product is gone
< ../scripts/traceparent.js
< ../scripts/jpa-only.js
GET http://localhost:{{application-port}}/v1/products/{{productId}}
Accept: application/json
Content-Type: application/json
traceparent: 00-{{traceId}}-{{spanId}}-03

> {%
    client.test("getProductById returns 404 after delete", function () {
        client.assert(response.status === 404, "expected 404 but got " + response.status);
    });
%}
